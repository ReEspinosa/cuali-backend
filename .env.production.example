# Copia este archivo como backend/.env en el servidor (junto al Dockerfile
# del backend) y rellena los valores reales. NUNCA lo subas a git.
# docker-compose.yml lo usa TANTO para el contenedor de Postgres como para
# el del backend, por eso las variables POSTGRES_* también van aquí.

# --- Seguridad ---
# Genera uno nuevo con: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=

# --- Base de datos (Postgres en Docker, servicio "db" del compose) ---
POSTGRES_USER=cuali
POSTGRES_PASSWORD=
POSTGRES_DB=cuali
DATABASE_URL=postgresql://cuali:MISMA_PASSWORD_QUE_ARRIBA@db:5432/cuali

# --- Correo (verificación de cuenta / reset de password) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- LLM (servidor de la UNAM vía LM Studio) ---
OPENAI_BASE_URL=https://dinamica1.fciencias.unam.mx/lmstudio/v1/
OPENAI_MODEL=openai/gpt-oss-20b
LLM_USER=
LLM_PASSWORD=

# --- RAG: embeddings locales, NO openai ---
EMBEDDING_PROVIDER=local
